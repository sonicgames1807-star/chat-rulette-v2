# Public domain pointing to your server. Required for docker-compose.yml.
DOMAIN=chat.example.com

# Optional TURN relay for more reliable voice calls.
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
# Shared secret must match the TURN server's REST-auth secret. Keep private.
TURN_SHARED_SECRET=
